<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description }}"><title>{{ title }} | Lyrian Scribe</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/blog.css">
</head>
<body><header class="site-header blog-header"><a class="brand" href="/"><span class="brand-mark">L<span>.</span></span><span class="brand-name">LYRIAN <b>SCRIBE</b></span></a><nav class="main-nav"><a href="/">Início</a><a href="/blog/">Blog</a><a class="nav-cta" href="/#contato">Vamos conversar ↗</a></nav></header>
<main class="article-wrap"><a class="back-link" href="/blog/">← Voltar ao blog</a><article class="article"><header><p class="article-meta"><time datetime="{{ date | date('yyyy-MM-dd') }}">{{ date | date('dd/MM/yyyy', 'pt-BR') }}</time>{% for category in categories %}<a href="/blog/categorias/{{ category | slug }}/">{{ category }}</a>{% endfor %}</p><h1>{{ title }}</h1><p class="article-summary">{{ description }}</p>{% if image %}<img class="article-cover" src="{{ image }}" alt="{{ image_alt or title }}">{% endif %}</header><div class="article-body">{{ content | safe }}</div></article><a class="back-link" href="/blog/">← Todos os artigos</a></main>
<footer class="site-footer"><a class="brand" href="/"><span class="brand-mark">L<span>.</span></span><span class="brand-name">LYRIAN <b>SCRIBE</b></span></a><p>Palavras com propósito. Conteúdo com direção.</p></footer></body></html>
